# These values are public and become part of the browser bundle. Never put API keys here.
# The {amount} placeholder receives a whole number of rubles selected on /support.
NEXT_PUBLIC_SUPPORT_SBP_URL_TEMPLATE=
NEXT_PUBLIC_SUPPORT_SBP_QR_URL_TEMPLATE=
NEXT_PUBLIC_SUPPORT_TELEGRAM_URL=

# Main editor route. `service` uses the workspace-scoped Job API; `local` keeps
# the explicit local-first /api/run adapter.
NEXT_PUBLIC_APE_RUNTIME_PROFILE=service
