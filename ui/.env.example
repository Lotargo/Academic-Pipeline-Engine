# These values are public and become part of the browser bundle. Never put API keys here.
# ЮMoney wallet number for the public voluntary-support form on /support.
# It is an identifier, not an API credential, and is submitted only to yoomoney.ru.
NEXT_PUBLIC_SUPPORT_YOOMONEY_RECEIVER=
NEXT_PUBLIC_SUPPORT_TELEGRAM_URL=

# Main editor route. `service` uses the workspace-scoped Job API; `local` keeps
# the explicit local-first /api/run adapter.
NEXT_PUBLIC_APE_RUNTIME_PROFILE=service

# Service provider-auth boundary. `mock` is visibly a local-only simulated
# provider flow; production must explicitly build with `supabase` and set the
# server-only APE_SUPABASE_URL plus OAuth configuration at deployment time.
NEXT_PUBLIC_APE_PROVIDER_AUTH_ADAPTER=mock

# Server-only canonical origin for provider callbacks. In service-dev it is
# http://localhost:3000; production must set its public HTTPS origin.
APE_PUBLIC_APP_ORIGIN=http://localhost:3000
