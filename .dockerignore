# Backend image context is an allow-list.  It avoids sending generated UI
# bundles, local exports, credentials, and the rest of the development tree.
*
!Dockerfile
!.dockerignore
!pyproject.toml
!poetry.lock
!alembic.ini
!academic_pe/
!academic_pe/**
!migrations/
!migrations/**
!config/
!config/**
!scripts/
!scripts/**
